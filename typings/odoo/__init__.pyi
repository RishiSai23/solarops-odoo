from typing import Any, Callable, TypeVar, Optional, Union, List, Dict

F = TypeVar('F', bound=Callable[..., Any])

def _(text: str) -> str: ...

class models:
    class Model:
        _name: str
        _description: str
        _inherit: Any
        _order: str
        _rec_name: str
        
        env: Any
        id: int
        name: Any
        display_name: str
        
        def __getattr__(self, name: str) -> Any: ...
        def __setattr__(self, name: str, value: Any) -> None: ...
        def __iter__(self) -> Any: ...
        def __len__(self) -> int: ...
        def __getitem__(self, key: Any) -> Any: ...
        def ensure_one(self) -> Any: ...
        def filtered(self, func: Any) -> Any: ...
        def mapped(self, path: str) -> Any: ...
        def sorted(self, key: Any = None, reverse: bool = False) -> Any: ...
        def exists(self) -> Any: ...
        def with_user(self, user: Any) -> Any: ...
        def with_context(self, *args: Any, **kwargs: Any) -> Any: ...
        def with_company(self, company: Any) -> Any: ...
        
        def write(self, vals: Dict[str, Any]) -> bool: ...
        def create(self, vals: Union[Dict[str, Any], List[Dict[str, Any]]]) -> Any: ...
        def unlink(self) -> bool: ...
        def copy(self, default: Optional[Dict[str, Any]] = ...) -> Any: ...
        def search(self, domain: List[Any], offset: int = 0, limit: Optional[int] = None, order: Optional[str] = None) -> Any: ...
        def search_count(self, domain: List[Any]) -> int: ...
        def browse(self, ids: Any) -> Any: ...
    
    class TransientModel(Model): ...
    class AbstractModel(Model): ...

class fields:
    class Field:
        def __init__(self, string: Optional[str] = None, **kwargs: Any) -> None: ...
        def __get__(self, instance: Any, owner: Any = None) -> Any: ...
        def __set__(self, instance: Any, value: Any) -> None: ...
        def __getattr__(self, name: str) -> Any: ...
        def __iter__(self) -> Any: ...
        def __len__(self) -> int: ...
        def __getitem__(self, key: Any) -> Any: ...
        def __call__(self, *args: Any, **kwargs: Any) -> Any: ...

    class Char(Field): ...
    class Text(Field): ...
    class Integer(Field): ...
    class Float(Field):
        def __init__(self, string: Optional[str] = None, digits: Any = None, **kwargs: Any) -> None: ...
    class Boolean(Field): ...
    class Date(Field):
        @classmethod
        def context_today(cls, record: Any = None) -> Any: ...
        @classmethod
        def today(cls) -> Any: ...
        @classmethod
        def to_date(cls, value: Any) -> Any: ...
        @classmethod
        def to_string(cls, value: Any) -> str: ...

    class Datetime(Field):
        @classmethod
        def now(cls) -> Any: ...
        @classmethod
        def today(cls) -> Any: ...
        @classmethod
        def context_timestamp(cls, record: Any, timestamp: Any) -> Any: ...
        @classmethod
        def to_datetime(cls, value: Any) -> Any: ...
        @classmethod
        def to_string(cls, value: Any) -> str: ...

    class Binary(Field): ...
    class Selection(Field):
        def __init__(self, selection: Any = None, string: Optional[str] = None, **kwargs: Any) -> None: ...
    class Many2one(Field):
        def __init__(self, comodel_name: str = ..., string: Optional[str] = None, **kwargs: Any) -> None: ...
    class One2many(Field):
        def __init__(self, comodel_name: str = ..., inverse_name: Optional[str] = None, string: Optional[str] = None, **kwargs: Any) -> None: ...
    class Many2many(Field):
        def __init__(self, comodel_name: str = ..., relation: Optional[str] = None, column1: Optional[str] = None, column2: Optional[str] = None, string: Optional[str] = None, **kwargs: Any) -> None: ...

class api:
    @staticmethod
    def depends(*args: str) -> Callable[[F], F]: ...
    @staticmethod
    def onchange(*args: str) -> Callable[[F], F]: ...
    @staticmethod
    def constrains(*args: str) -> Callable[[F], F]: ...
    @staticmethod
    def model(fn: F) -> F: ...
    @staticmethod
    def model_create_multi(fn: F) -> F: ...
    @staticmethod
    def returns(model: str, downgrade: Optional[Callable[..., Any]] = None) -> Callable[[F], F]: ...
    @staticmethod
    def autovacuum(fn: F) -> F: ...

class exceptions:
    class UserError(Exception): ...
    class ValidationError(Exception): ...
    class AccessError(Exception): ...
    class MissingError(Exception): ...
