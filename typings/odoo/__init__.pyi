from typing import Any, Callable, TypeVar, Optional, Union, List, Dict

F = TypeVar('F', bound=Callable[..., Any])

def _(text: str) -> str: ...

class models:
    class Model:
        _name: str
        _description: str
        _inherit: Any
        _order: str
        _rec_name: str
        
        env: Any
        id: int
        
        def write(self, vals: Dict[str, Any]) -> bool: ...
        def create(self, vals: Dict[str, Any]) -> Any: ...
        def unlink(self) -> bool: ...
        def copy(self, default: Optional[Dict[str, Any]] = ...) -> Any: ...
        def search(self, domain: List[Any], offset: int = 0, limit: Optional[int] = None, order: Optional[str] = None) -> Any: ...
        def browse(self, ids: Any) -> Any: ...
    
    class TransientModel(Model): ...
    class AbstractModel(Model): ...

class fields:
    class Field:
        def __init__(self, string: Optional[str] = None, **kwargs: Any) -> None: ...

    class Char(Field): ...
    class Text(Field): ...
    class Integer(Field): ...
    class Float(Field):
        def __init__(self, string: Optional[str] = None, digits: Any = None, **kwargs: Any) -> None: ...
    class Boolean(Field): ...
    class Date(Field): ...
    class Datetime(Field): ...
    class Binary(Field): ...
    class Selection(Field):
        def __init__(self, selection: Any = None, string: Optional[str] = None, **kwargs: Any) -> None: ...
    class Many2one(Field):
        def __init__(self, comodel_name: str = ..., string: Optional[str] = None, **kwargs: Any) -> None: ...
    class One2many(Field):
        def __init__(self, comodel_name: str = ..., inverse_name: Optional[str] = None, string: Optional[str] = None, **kwargs: Any) -> None: ...
    class Many2many(Field):
        def __init__(self, comodel_name: str = ..., relation: Optional[str] = None, column1: Optional[str] = None, column2: Optional[str] = None, string: Optional[str] = None, **kwargs: Any) -> None: ...

class api:
    @staticmethod
    def depends(*args: str) -> Callable[[F], F]: ...
    @staticmethod
    def onchange(*args: str) -> Callable[[F], F]: ...
    @staticmethod
    def constrains(*args: str) -> Callable[[F], F]: ...
    @staticmethod
    def model(fn: F) -> F: ...
    @staticmethod
    def returns(model: str, downgrade: Optional[Callable[..., Any]] = None) -> Callable[[F], F]: ...
    @staticmethod
    def autovacuum(fn: F) -> F: ...

class exceptions:
    class UserError(Exception): ...
    class ValidationError(Exception): ...
    class AccessError(Exception): ...
    class MissingError(Exception): ...
