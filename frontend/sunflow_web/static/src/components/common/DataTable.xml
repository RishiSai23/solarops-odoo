<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="sunflow_web.DataTable">
        <div class="o_sunflow_table_wrapper">
            <table class="o_sunflow_table">
                <thead>
                    <tr>
                        <th t-foreach="props.columns or []" t-as="col" t-key="col.key" t-esc="col.label"/>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="props.rows or []" t-as="row" t-key="row.id or row_index">
                        <td t-foreach="props.columns or []" t-as="col" t-key="col.key" t-esc="row[col.key]"/>
                    </tr>
                </tbody>
            </table>
        </div>
    </t>
</templates>
