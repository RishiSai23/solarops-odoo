<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================================================================== -->
    <!-- Sequences                                                           -->
    <!-- ================================================================== -->

    <record id="seq_solar_project" model="ir.sequence">
        <field name="name">Solar Project Sequence</field>
        <field name="code">solar.project</field>
        <field name="prefix">SPF-</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_solar_equipment_dispatch" model="ir.sequence">
        <field name="name">Solar Equipment Dispatch Sequence</field>
        <field name="code">solar.equipment.dispatch</field>
        <field name="prefix">DISP-</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- ================================================================== -->
    <!-- Product Categories for Solar Components                            -->
    <!-- ================================================================== -->

    <record id="product_categ_solar" model="product.category">
        <field name="name">Solar Equipment</field>
        <field name="parent_id" ref="product.product_category_all"/>
    </record>

    <record id="product_categ_solar_panels" model="product.category">
        <field name="name">Solar Panels</field>
        <field name="parent_id" ref="product_categ_solar"/>
    </record>

    <record id="product_categ_solar_inverters" model="product.category">
        <field name="name">Inverters</field>
        <field name="parent_id" ref="product_categ_solar"/>
    </record>

    <record id="product_categ_solar_batteries" model="product.category">
        <field name="name">Battery Storage</field>
        <field name="parent_id" ref="product_categ_solar"/>
    </record>

    <record id="product_categ_solar_accessories" model="product.category">
        <field name="name">BOS &amp; Accessories</field>
        <field name="parent_id" ref="product_categ_solar"/>
    </record>

</odoo>

