<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- =====================================================================
         Survey Reject Wizard View
         ===================================================================== -->
    <record id="view_survey_reject_wizard_form" model="ir.ui.view">
        <field name="name">solar.survey.reject.wizard.form</field>
        <field name="model">solar.survey.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Site Survey">
                <group string="Rejection Details">
                    <field name="survey_id" readonly="1"/>
                    <field name="remarks" widget="text"/>
                </group>
                <footer>
                    <button name="action_reject_confirm" type="object" string="Reject"
                            class="oe_highlight"/>
                    <button string="Cancel" class="btn-default" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- =====================================================================
         Survey Reject Wizard Action
         ===================================================================== -->
    <record id="action_survey_reject_wizard" model="ir.actions.act_window">
        <field name="name">Reject Survey</field>
        <field name="res_model">solar.survey.reject.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
