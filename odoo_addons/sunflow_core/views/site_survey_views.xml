<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Site Survey List View -->
    <record id="view_solar_survey_tree" model="ir.ui.view">
        <field name="name">solar.survey.tree</field>
        <field name="model">solar.survey</field>
        <field name="arch" type="xml">
            <tree string="Site Surveys"
                  decoration-success="state == 'approved'"
                  decoration-danger="state == 'rejected'"
                  decoration-warning="state == 'submitted'">
                <field name="name"/>
                <field name="project_id"/>
                <field name="lead_id"/>
                <field name="surveyor_id"/>
                <field name="survey_date"/>
                <field name="roof_type"/>
                <field name="sanctioned_load_kw"/>
                <field name="feasibility_status"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <!-- Site Survey Search View -->
    <record id="view_solar_survey_search" model="ir.ui.view">
        <field name="name">solar.survey.search</field>
        <field name="model">solar.survey</field>
        <field name="arch" type="xml">
            <search string="Search Site Surveys">
                <field name="name"/>
                <field name="project_id"/>
                <field name="lead_id"/>
                <field name="surveyor_id"/>
                <field name="survey_date"/>

                <filter name="filter_draft"
                        string="Draft"
                        domain="[('state','=','draft')]"/>
                <filter name="filter_scheduled"
                        string="Scheduled"
                        domain="[('state','=','scheduled')]"/>
                <filter name="filter_in_progress"
                        string="In Progress"
                        domain="[('state','=','in_progress')]"/>
                <filter name="filter_submitted"
                        string="Submitted"
                        domain="[('state','=','submitted')]"/>
                <filter name="filter_approved"
                        string="Approved"
                        domain="[('state','=','approved')]"/>
                <filter name="filter_rejected"
                        string="Rejected"
                        domain="[('state','=','rejected')]"/>

                <separator/>

                <filter name="filter_feasible"
                        string="Feasible"
                        domain="[('feasibility_status','=','feasible')]"/>
                <filter name="filter_conditional"
                        string="Conditional"
                        domain="[('feasibility_status','=','conditional')]"/>
                <filter name="filter_not_feasible"
                        string="Not Feasible"
                        domain="[('feasibility_status','=','rejected')]"/>

                <group string="Group By">
                    <filter name="group_by_project"
                            string="Project"
                            context="{'group_by':'project_id'}"/>
                    <filter name="group_by_surveyor"
                            string="Surveyor"
                            context="{'group_by':'surveyor_id'}"/>
                    <filter name="group_by_state"
                            string="Workflow State"
                            context="{'group_by':'state'}"/>
                    <filter name="group_by_feasibility"
                            string="Feasibility"
                            context="{'group_by':'feasibility_status'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Site Survey Form View -->
    <record id="view_solar_survey_form" model="ir.ui.view">
        <field name="name">solar.survey.form</field>
        <field name="model">solar.survey</field>
        <field name="arch" type="xml">
            <form string="Site Survey">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group string="General Information">
                            <field name="project_id"/>
                            <field name="lead_id"/>
                            <field name="surveyor_id"/>
                            <field name="survey_date"/>
                        </group>
                        <group string="Status">
                            <field name="state" widget="badge"/>
                            <field name="feasibility_status"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Roof Assessment">
                            <group>
                                <group>
                                    <field name="roof_type"/>
                                    <field name="roof_direction"/>
                                    <field name="azimuth_degrees"/>
                                </group>
                                <group>
                                    <field name="tilt_degrees"/>
                                    <field name="shading_factor_pct"/>
                                    <field name="usable_area_sqft"/>
                                </group>
                            </group>
                            <group>
                                <field name="shading_notes"/>
                            </group>
                        </page>

                        <page string="Electrical Assessment">
                            <group>
                                <group>
                                    <field name="sanctioned_load_kw"/>
                                    <field name="meter_phase"/>
                                    <field name="service_voltage"/>
                                </group>
                                <group>
                                    <field name="cable_distance"/>
                                </group>
                            </group>
                        </page>

                        <page string="Survey Notes">
                            <group>
                                <field name="survey_notes"/>
                                <field name="remarks"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>

                <chatter/>
            </form>
        </field>
    </record>

    <!-- Site Survey Window Action -->
    <record id="action_solar_site_survey" model="ir.actions.act_window">
        <field name="name">Site Surveys</field>
        <field name="res_model">solar.survey</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_solar_survey_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Site Survey Records
            </p>
            <p>
                View and manage rooftop feasibility surveys.
            </p>
        </field>
    </record>

</odoo>
