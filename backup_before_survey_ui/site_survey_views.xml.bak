<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- =====================================================================
         Site Survey Tree / List View
         ===================================================================== -->
    <record id="view_solar_survey_tree" model="ir.ui.view">
        <field name="name">solar.survey.tree</field>
        <field name="model">solar.survey</field>
        <field name="arch" type="xml">
            <tree string="Site Surveys" decoration-success="state=='approved'"
                  decoration-danger="state=='rejected'"
                  decoration-warning="state=='submitted'"
                  decoration-info="state in ('draft','scheduled','in_progress')">
                <field name="name"/>
                <field name="project_id"/>
                <field name="lead_id"/>
                <field name="surveyor_id"/>
                <field name="survey_date"/>
                <field name="roof_type"/>
                <field name="recommended_system_capacity_kw"/>
                <field name="feasibility_status"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <!-- =====================================================================
         Site Survey Search View
         ===================================================================== -->
    <record id="view_solar_survey_search" model="ir.ui.view">
        <field name="name">solar.survey.search</field>
        <field name="model">solar.survey</field>
        <field name="arch" type="xml">
            <search string="Search Site Surveys">
                <field name="name"/>
                <field name="project_id"/>
                <field name="lead_id"/>
                <field name="surveyor_id"/>
                <field name="state"/>
                <field name="feasibility_status"/>
                <field name="survey_date"/>

                <filter name="filter_draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="filter_scheduled" string="Scheduled" domain="[('state','=','scheduled')]"/>
                <filter name="filter_in_progress" string="In Progress" domain="[('state','=','in_progress')]"/>
                <filter name="filter_submitted" string="Submitted" domain="[('state','=','submitted')]"/>
                <filter name="filter_approved" string="Approved" domain="[('state','=','approved')]"/>
                <filter name="filter_rejected" string="Rejected" domain="[('state','=','rejected')]"/>

                <separator/>

                <filter name="filter_feasible" string="Feasible" domain="[('feasibility_status','=','feasible')]"/>
                <filter name="filter_conditional" string="Conditional" domain="[('feasibility_status','=','conditional')]"/>
                <filter name="filter_feasibility_rejected" string="Rejected (Feasibility)" domain="[('feasibility_status','=','rejected')]"/>

                <group string="Group By">
                    <filter name="group_by_technician" string="Technician" domain="[]" context="{'group_by':'surveyor_id'}"/>
                    <filter name="group_by_project" string="Project" domain="[]" context="{'group_by':'project_id'}"/>
                    <filter name="group_by_state" string="Workflow State" domain="[]" context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- =====================================================================
         Site Survey Form View
         ===================================================================== -->
    <record id="view_solar_survey_form" model="ir.ui.view">
        <field name="name">solar.survey.form</field>
        <field name="model">solar.survey</field>
        <field name="arch" type="xml">
            <form string="Site Survey">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,scheduled,in_progress,submitted,approved,rejected"/>
                    <button name="action_schedule" string="Schedule" type="object"
                            class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_start" string="Start Survey" type="object"
                            invisible="state != 'scheduled'"/>
                    <button name="action_submit" string="Submit Survey" type="object"
                            class="oe_highlight"
                            invisible="state != 'in_progress'"/>
                    <button name="action_approve" string="Approve" type="object"
                            class="oe_highlight"
                            groups="base.group_system"
                            invisible="state != 'submitted'"/>
                    <button name="%(action_survey_reject_wizard)d" type="action" string="Reject"
                            groups="base.group_system"
                            invisible="state != 'submitted'"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object"
                            invisible="state not in ('approved','rejected')"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <notebook>
                        <page string="General Information">
                            <group string="General">
                                <group string="Reference &amp; Assignment">
                                    <field name="name" readonly="1"/>
                                    <field name="project_id" required="1"/>
                                    <field name="lead_id"/>
                                    <field name="surveyor_id" readonly="state in ('submitted','approved','rejected')"/>
                                    <field name="survey_date"/>
                                    <field name="state" readonly="1"/>
                                </group>
                                <group string="Workflow &amp; State">
                                    <field name="state" readonly="1" widget="statusbar" statusbar_visible="draft,scheduled,in_progress,submitted,approved,rejected" invisible="1"/>
                                </group>
                            </group>
                        </page>

                        <page string="Roof Assessment">
                            <group string="Roof Details">
                                <group>
                                    <field name="roof_type"/>
                                    <field name="roof_direction"/>
                                    <field name="azimuth_degrees"/>
                                </group>
                                <group>
                                    <field name="tilt_degrees"/>
                                    <field name="shading_factor_pct"/>
                                    <field name="usable_area_sqft"/>
                                </group>
                            </group>
                        </page>

                        <page string="Electrical &amp; Grid Assessment">
                            <group string="Grid Details">
                                <group>
                                    <field name="cable_distance"/>
                                    <field name="sanctioned_load_kw"/>
                                    <field name="meter_phase"/>
                                </group>
                                <group>
                                    <field name="grid_suitability"/>
                                    <field name="recommended_system_capacity_kw"/>
                                </group>
                            </group>
                        </page>

                        <page string="Electricity Bill &amp; Documents">
                            <group string="Attachments">
                                <group string="Electricity Bill">
                                    <field name="electricity_bill_attachment_ids"
                                           widget="many2many_tags"
                                           readonly="state in ('approved','rejected')"/>
                                </group>
                                <group string="Site Photos">
                                    <field name="site_photo_attachment_ids"
                                           widget="many2many_tags"
                                           readonly="state in ('approved','rejected')"/>
                                </group>
                                <group string="Documents">
                                    <field name="document_attachment_ids"
                                           widget="many2many_tags"
                                           readonly="state in ('approved','rejected')"/>
                                </group>
                            </group>
                        </page>

                        <page string="Recommendations">
                            <group string="Recommendations">
                                <group>
                                    <field name="recommended_system_capacity_kw"/>
                                    <field name="feasibility_status"/>
                                </group>
                                <group string="Observations">
                                    <field name="technician_observations"
                                           readonly="state in ('submitted','approved','rejected')"/>
                                    <field name="survey_notes"
                                           readonly="state in ('submitted','approved','rejected')"/>
                                </group>
                            </group>
                        </page>

                        <page string="Approval Details">
                            <group string="Approval Information" groups="base.group_system">
                                <group>
                                    <field name="approval_remarks" readonly="1"/>
                                    <field name="approved_by" readonly="1"/>
                                    <field name="approved_date" readonly="1"/>
                                    <field name="rejected_by" readonly="1"/>
                                    <field name="rejected_date" readonly="1"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- =====================================================================
         Site Survey Action Window
         ===================================================================== -->
    <record id="action_solar_site_survey" model="ir.actions.act_window">
        <field name="name">Site Surveys</field>
        <field name="res_model">solar.survey</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_solar_survey_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create the first Site Survey record!
            </p>
        </field>
    </record>
</odoo>
