<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Solar Pipeline Stages -->
    <record id="stage_solar_new" model="crm.stage">
        <field name="name">New</field>
        <field name="sequence">1</field>
        <field name="requirements">Initial customer inquiry received via WhatsApp, Website, Phone, or manual intake.</field>
    </record>

    <record id="stage_solar_contacted" model="crm.stage">
        <field name="name">Contacted</field>
        <field name="sequence">2</field>
        <field name="requirements">Customer reached by sales rep. Initial requirements discussion initiated.</field>
    </record>

    <record id="stage_solar_qualification_pending" model="crm.stage">
        <field name="name">Qualification Pending</field>
        <field name="sequence">3</field>
        <field name="requirements">Electricity bills, rooftop area, or NOC permissions requested from customer.</field>
    </record>

    <record id="stage_solar_qualified" model="crm.stage">
        <field name="name">Qualified</field>
        <field name="sequence">4</field>
        <field name="requirements">Technical and commercial pre-qualification passed. Bill and rooftop space verified.</field>
    </record>

    <record id="stage_solar_survey_ready" model="crm.stage">
        <field name="name">Survey Ready</field>
        <field name="sequence">5</field>
        <field name="requirements">Site address confirmed and ready for dispatching a rooftop technical surveyor.</field>
    </record>

    <record id="stage_solar_converted" model="crm.stage">
        <field name="name">Converted</field>
        <field name="sequence">6</field>
        <field name="fold">True</field>
        <field name="is_won">True</field>
        <field name="requirements">Lead successfully converted into customer profile and solar opportunity.</field>
    </record>
</odoo>
